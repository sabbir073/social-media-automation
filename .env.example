# ---------- Core ----------
# Public HTTPS URL of the app, no trailing slash. OAuth redirects and media URLs are built from it.
APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=AutoPoster
DOMAIN=app.example.com

DATABASE_URL=postgresql://app:change-me@postgres:5432/social
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379

# Generate each with: openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_KEY=

# The account registered with this email becomes the admin.
ADMIN_EMAIL=you@example.com

# ---------- Uploads ----------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=512

# ---------- Billing ----------
TRIAL_DAYS=7
# "manual" = user submits a payment reference, admin approves. Add your gateway in src/lib/billing/gateway.ts.
BILLING_PROVIDER=manual
BILLING_INSTRUCTIONS=Send the plan amount to bKash 01XXXXXXXXX (Send Money) and enter the transaction ID below.

# ---------- Meta (Facebook Pages + Instagram) ----------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# ---------- Google (YouTube + optional Sheets service account) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 of the service-account JSON key. Users share their sheet with this account's email.
# Leave empty to read sheets shared as "Anyone with the link can view" instead.
GOOGLE_SERVICE_ACCOUNT_B64=

# ---------- Pinterest ----------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Use https://api-sandbox.pinterest.com while the app is on Trial access.
PINTEREST_API_BASE=https://api.pinterest.com

# ---------- AI assistant (optional): composer buttons and the AI planner ----------
# Option A, a model on your own machine or any OpenAI-compatible server:
#   Docker Desktop Model Runner: AI_BASE_URL=http://model-runner.docker.internal/engines/v1
#                                AI_MODEL=<name from `docker model list`, e.g. ai/qwen3.5:4b-q4_K_M>
#   Ollama:                      AI_BASE_URL=http://host.docker.internal:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Option B, Anthropic (used when AI_BASE_URL is empty; AI_MODEL defaults to claude-haiku-5-5):
ANTHROPIC_API_KEY=

# ---------- Email (password reset). Leave empty to log reset links to the server log. ----------
SMTP_URL=
MAIL_FROM=AutoPoster <no-reply@example.com>

# ---------- Development only ----------
# Adds a fake "Test network" so the whole pipeline can be exercised without any platform approval.
ENABLE_MOCK_PROVIDER=false
